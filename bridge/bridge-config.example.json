    "max_new_tokens": 1536,
    "blocksize": 512,
    "streaming_chunk_size": 4
  },
  "turn": {
    "enabled": false,
    "mode": "text",
    "text_model": "models/qwen3-0.6b",
    "text_device": "cpu",
    "text_threshold": 0.2,
    "model": "models/smart-turn/smart-turn-v3.2-gpu.onnx",
    "threads": 4,
    "threshold": 0.5
  },
  "media": {
    "bg_images_dir": "assets/bg-images",
    "task_videos_dir": "assets/task-videos"
  },
  "deepseek": {
    "api_key": ""
